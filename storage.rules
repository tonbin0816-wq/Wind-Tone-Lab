rules_version = '2';

// ====================================================================
// アイコンの写真の置き場(便AH 2026-09-23 凍結仕様 決定7)
//   docs/superpowers/specs/2026-09-23-avatar-photo.md
//
// 【置き場が2つある理由】1つにすると、判定を通ったあとで**同じ場所を別の画像で
// 上書き**できてしまい、users に載っている場所の中身だけがすり替わる。
// 場所を分けると、画面に出る側をクライアントが1バイトも書けなくなる。
//
//   avatarUploads/{uid}/photo.webp … クライアントが書ける。**誰も見ない**
//   avatars/{uid}/{file}           … 関数(Admin SDK)だけが書ける。**ここだけが画面に出る**
//                                     (画面へは鍵付きの URL で出す。ルールでの読みは閉じてある ── 便BH)
//
// 【上限は3つとも「青天井にしない」ためのもの(決定7)】
//   ・置ける場所は自分の uid の下だけ
//   ・1人1枚 … 名前を photo.webp に固定してある。他の名前は下の既定の拒否に落ちる
//   ・大きさ 256KiB … 256px の WebP は実測で 10〜30KB。十分な余裕を見た固定値
//     **src/community/avatarPhoto.js の PHOTO_MAX_BYTES の写し。片方だけ直さないこと。**
//   ・image/webp か image/jpeg のみ(便AP: iPhone の Safari は WebP を書き出せない)
//     名前は JPEG でも photo.webp のまま(1人1枚の鍵。形式は Content-Type と関数が中身で見る)
// ====================================================================
service firebase.storage {
  match /b/{bucket}/o {

    // 判定を通った写真。**クライアントは誰も書けない。**
    // 【便BH 2026-10-01 本人裁定 読みも閉じた】以前は allow read: if true だった。
    // ・画面に出すのは users.photo の**鍵(token)付きの URL** で、鍵付きの URL はこのルールを
    //   通らない(Firebase が鍵で通す)。だから読みを閉じても表示は変わらない。
    // ・開けたままだと、鍵を持たない誰でも SDK で avatars/{uid}/ を list して
    //   uid から写真を辿れる・名前さえ分かれば読める。公開をやめた人の写真も同じ。
    //   しかも getDownloadURL は**いまの鍵**の URL を返すので、鍵を入れ替えても取り直せてしまう。
    //   公開をやめたら関数(cleanAvatarPhoto)が鍵を入れ替え、users.photo を新しい鍵の URL に
    //   替える。閉じておけば、**古い鍵の URL でも、鍵を持たない道でも読めなくなる。**
    //   ただし、すでに見た人の端末のキャッシュは消せない。
    // ・アプリはここを SDK(getDownloadURL / getBlob / getBytes / listAll)で読んでいない
    //   (便BH で src 全体を確かめた)。関数は Admin SDK なのでルールを通らない。
    match /avatars/{uid}/{file} {
      allow read: if false;
      allow write: if false;
    }

    // クライアントが書ける唯一の置き場。**判定前なので誰にも見せない**
    // (本人だけが読める ── 上げ直すときに自分の物であることを確かめられるように)。
    match /avatarUploads/{uid}/photo.webp {
      allow read: if request.auth != null && request.auth.uid == uid;
      // 【create と update を分けて書く】write のままだと request.resource が
      // null になる delete まで同じ式で見ることになり、**自分の置き場を消せなくなる**。
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource != null
        && request.resource.size <= 262144
        // 【便AP 2026-09-24】JPEG も受ける(iPhone の Safari は canvas を WebP で書き出せない)。
        // 申告を見るだけなので、中身は関数(photoKindOf)が見る。
        && request.resource.contentType in ['image/webp', 'image/jpeg'];
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 【既定は拒否】上で名指ししていない場所は読み書きとも通さない。
    // 「1人1枚」はここが担っている ── photo.webp 以外の名前はここに落ちる。
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
