rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      // 公開プロフィールは誰でも読める。非公開は本人のみ(spec: 非公開でも復元用にクラウド保存する)
      allow get: if resource.data.isPublic == true || (request.auth != null && request.auth.uid == uid);
      allow list: if false; // 一覧APIは計画2まで封鎖(公開一覧の設計とセットで開ける)
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['nickname','saxType','position','startYear','genres','ensembles','places','gear','deviceClass','isPublic','ageConfirmed','updatedAt'])
        && request.resource.data.keys().hasOnly(['nickname','saxType','position','startYear','genres','ensembles','places','gear','deviceClass','isPublic','ageConfirmed','updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        // size() は UTF-8 のバイト長。クライアントの上限20コードポイントに対し、
        // 1コードポイント最大4バイトなので 80 が厳密な最悪値の上界になる
        && request.resource.data.nickname.size() <= 80
        && request.resource.data.saxType in ['soprano','alto','tenor','baritone']
        // ---- ここから position / genres / ensembles / places の選択肢 ----
        // 【src/community/profile.js の POSITIONS / GENRES / ENSEMBLES / PLACES の写し】
        // 計画1に Cloud Functions は無いので、このルールが唯一のサーバ側の検査である。
        // 「文字列で60字以内」までしか見ないと、生SDKを叩く相手が position に中傷を入れて
        // 世界中から読めるプロフィールに載せられてしまい、設計書 §8.1 の
        // 「通報の対象はニックネームだけ」という性質(= 自動モデレーションが成立する根拠)が崩れる。
        // 自由入力はニックネーム1つだけ、を型で担保するために列挙で固定する。
        // **profile.js 側の定数を足し引きしたら、必ずここも直すこと**(逆も同じ)。
        // 同期は src/community/profile.test.js の「Firestore ルールの列挙と一致する」で検査している。
        && request.resource.data.position in ['中学吹奏楽部','高校吹奏楽部','大学吹奏楽・サークル','音大生','社会人','講師・プロ','独学']
        && request.resource.data.startYear is int
        && request.resource.data.startYear >= 1900
        && request.resource.data.startYear <= 2200
        && request.resource.data.genres is list && request.resource.data.genres.size() <= 8
        && request.resource.data.genres.hasOnly(['クラシック','ジャズ','ポップス','その他'])
        && request.resource.data.ensembles is list && request.resource.data.ensembles.size() <= 8
        && request.resource.data.ensembles.hasOnly(['ソロ','アンサンブル','ビッグバンド','吹奏楽','オーケストラ'])
        && request.resource.data.places is list && request.resource.data.places.size() <= 8
        && request.resource.data.places.hasOnly(['自宅','学校の音楽室','個人練習室','スタジオ','カラオケ','屋外'])
        // ---- ここまで ----
        && request.resource.data.gear is map
        && request.resource.data.gear.keys().hasAll(['instrumentBrand','instrumentModel','mpBrand','mpModel'])
        && request.resource.data.gear.keys().hasOnly(['instrumentBrand','instrumentModel','mpBrand','mpModel'])
        // gear の中身も自由入力の入口になりうるので型と長さを見る。
        // null は「未選択」を表す正当な値なので許す(「その他」= 文字列 とは別物。gear.js 参照)。
        // 60 は position に合わせた上界。カタログの型番はどれもこれより十分短い。
        && (request.resource.data.gear.instrumentBrand == null || (request.resource.data.gear.instrumentBrand is string && request.resource.data.gear.instrumentBrand.size() <= 60))
        && (request.resource.data.gear.instrumentModel == null || (request.resource.data.gear.instrumentModel is string && request.resource.data.gear.instrumentModel.size() <= 60))
        && (request.resource.data.gear.mpBrand == null || (request.resource.data.gear.mpBrand is string && request.resource.data.gear.mpBrand.size() <= 60))
        && (request.resource.data.gear.mpModel == null || (request.resource.data.gear.mpModel is string && request.resource.data.gear.mpModel.size() <= 60))
        && request.resource.data.deviceClass in ['ios','android','pc']
        && request.resource.data.updatedAt is string
        && request.resource.data.isPublic is bool
        // 年齢は自己申告であり検証ではない。13歳未満の利用を規約で禁じるための同意記録
        && request.resource.data.ageConfirmed == true;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} { allow read, write: if false; } // 未定義コレクションは全拒否
  }
}
